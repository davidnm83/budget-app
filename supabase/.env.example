# Copy to supabase/.env, fill in, then upload with:
#   npx supabase secrets set --env-file supabase/.env
# These are SERVER secrets. Never put them in apps/app/.env and never commit supabase/.env.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-production-secret
PLAID_ENV=production
PLAID_COUNTRY_CODES=US
APP_TIMEZONE=America/New_York   # any IANA time zone; the daily sync runs at 5 AM there
DEFAULT_CURRENCY=USD            # used when the bank doesn't say
CRON_SECRET=a-long-random-string
# PLAID_REDIRECT_URI=https://your-app.example.com/oauth
