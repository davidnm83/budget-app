# Copy to apps/app/.env. Only these two values belong in the app.
# From Supabase: Project Settings > API Keys. The publishable key is safe to ship in the app
# (row-level security protects the data). Older projects: use the "anon" key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
