# ── App (apps/app/.env) ──────────────────────────────────────────────
# From Supabase: Project Settings > API Keys. The publishable key is safe to ship in the app
# (row-level security protects the data). Older projects: use the "anon" key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Edge Function secrets (set with `supabase secrets set`, never commit) ──
# From the Plaid Dashboard > Developers > Keys. Trial plan = production environment.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-production-secret
PLAID_ENV=production            # or sandbox for testing with fake banks
PLAID_COUNTRY_CODES=CA,US
APP_TIMEZONE=America/Toronto    # the daily sync runs at 5 AM in this time zone
CRON_SECRET=make-a-long-random-string   # e.g. `openssl rand -hex 32`; also stored in Vault by setup/cron.sql
# PLAID_REDIRECT_URI=https://your-app.example.com/oauth   # only for banks that use OAuth on the web
